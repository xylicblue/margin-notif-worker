# Required chain configuration. Replace every angle-bracket placeholder.
# The RPC endpoint only needs read access. Never configure a blockchain private key.
RPC_URL=https://<rpc-host>
CHAIN_ID=11155111
CLEARING_HOUSE_ADDRESS=0x<40-hex-character-proxy-address>
DEPLOYMENT_BLOCK=<deployment-block-number>

# JSON array of every monitored bytes32 market ID and its client-facing label.
# For Sepolia, use the contents of config/markets.sepolia.json as one JSON line.
MARKETS_JSON=[{"id":"0x<64-hex-character-market-id>","label":"MARKET-PERP"}]

# Required Supabase server credentials. Configure these as Railway secrets.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Start every deployment in shadow mode. Promote only after rollout verification.
DELIVERY_MODE=shadow
APP_URL=https://<production-app-domain>

# Optional operational tuning. These defaults are safe starting values.
POLL_INTERVAL_MS=10000
EVENT_SCAN_INTERVAL_MS=5000
DELIVERY_INTERVAL_MS=2000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_SECONDS=30
HEARTBEAT_INTERVAL_MS=60000
BLOCK_CONFIRMATIONS=2
EVENT_CHUNK_SIZE=2000
MAX_POSITION_BATCH=250
RISK_READ_CONCURRENCY=20
WORKER_LEASE_SECONDS=30
LOG_LEVEL=info

# Margin-warning thresholds and reminder intervals.
WARNING_MULTIPLIER=2
DANGER_MULTIPLIER=1.5
NEAR_LIQUIDATION_MULTIPLIER=1.1
A1_REMINDER_SECONDS=300
A2_REMINDER_SECONDS=120
A3_REMINDER_SECONDS=30

# Required only after DELIVERY_MODE is promoted to all.
RESEND_API_KEY=
EMAIL_FROM=ByteStrike <verified-sender@your-domain>
VAPID_SUBJECT=mailto:<operations-email>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
